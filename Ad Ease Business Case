    "HORIZON = 30\n",
    "future_idx = pd.date_range(lang_mean.index[-1] + pd.Timedelta(days=1), periods=HORIZON, freq=\"D\")\n",
    "future_exog = pd.Series(0, index=future_idx)\n",
    "\n",
    "\n",
    "def forecast_future(lang, model):\n",
    "\n",
    "    y = lang_mean[lang]\n",
    "\n",
    "    if model.startswith(\"Prophet\"):\n",
    "        train = pd.DataFrame({\"ds\": y.index, \"y\": y.values})\n",
    "        future = pd.DataFrame({\"ds\": future_idx})\n",
    "        m = Prophet(weekly_seasonality=True, daily_seasonality=False,\n",
    "                    yearly_seasonality=False, interval_width=0.95)\n",
    "        if model == \"Prophet(exog)\":\n",
    "            train[\"exog\"], future[\"exog\"] = exog.values, future_exog.values\n",
    "            m.add_regressor(\"exog\")\n",
    "        m.fit(train)\n",
    "        out = m.predict(future)\n",
    "        pred = pd.Series(out[\"yhat\"].values, index=future_idx)\n",
    "        ci = pd.DataFrame({\"lower\": out[\"yhat_lower\"].values,\n",
    "                           \"upper\": out[\"yhat_upper\"].values}, index=future_idx)\n",
    "        return pred, ci\n",
    "\n",
    "    # ARIMA / SARIMA / SARIMAX: reusing the orders found by the grid search\n",
    "    params = all_params[lang]\n",
    "    order, sorder = params[\"ARIMA\"] if model == \"ARIMA\" else params[\"SARIMA\"]\n",
    "    use_exog = (model == \"SARIMAX\")\n",
    "\n",
    "    fit = SARIMAX(y, exog=exog.values if use_exog else None,\n",
    "                  order=order, seasonal_order=sorder,\n",
    "                  initialization=\"approximate_diffuse\").fit(disp=False)\n",
    "    fc = fit.get_forecast(HORIZON, exog=future_exog.values if use_exog else None)\n",
    "    pred = pd.Series(fc.predicted_mean.values, index=future_idx)\n",
    "    ci = pd.DataFrame(fc.conf_int().values, columns=[\"lower\", \"upper\"], index=future_idx)\n",
    "    return pred, ci\n",
    "\n",
    "\n",
    "# Forecasting with the best model of each language\n",
    "future = {lang: forecast_future(lang, row[\"model\"]) for lang, row in best.iterrows()}\n",
    "\n",
    "# Plot\n",
