    "def grid_search(y_train, seasonal=True):\n",
    "    \"\"\"Returns the (order, seasonal_order) with the lowest AIC on the training data.\"\"\"\n",
    "    PQ = [0, 1] if seasonal else [0]\n",
    "    best_aic, best = np.inf, None\n",
    "    for p, q, P, Q in itertools.product([0, 1, 2], [0, 1, 2], PQ, PQ):\n",
    "        order = (p, 1, q)\n",
    "        sorder = (P, 1, Q, SEASONAL_PERIOD) if seasonal else (0, 0, 0, 0)\n",
    "        try:\n",
    "            aic = SARIMAX(y_train, order=order, seasonal_order=sorder).fit(disp=False).aic\n",
    "        except Exception:\n",
    "            continue\n",
    "        if aic < best_aic:\n",
    "            best_aic, best = aic, (order, sorder)\n",
    "    return best\n",
    "\n",
    "\n",
    "def sarimax_forecast(y_train, order, sorder, ex_train=None, ex_test=None):\n",
    "    fit = SARIMAX(y_train, exog=ex_train, order=order, seasonal_order=sorder,\n",
    "                  initialization=\"approximate_diffuse\").fit(disp=False)\n",
    "    return fit.forecast(steps=TEST_DAYS, exog=ex_test)\n",
    "\n",
    "\n",
    "def prophet_forecast(y_train, y_test, ex_train=None, ex_test=None):\n",
    "    train = pd.DataFrame({\"ds\": y_train.index, \"y\": y_train.values})\n",
    "    test = pd.DataFrame({\"ds\": y_test.index})\n",
    "    m = Prophet(weekly_seasonality=True, daily_seasonality=False, yearly_seasonality=False)\n",
    "    if ex_train is not None:\n",
    "        train[\"exog\"], test[\"exog\"] = ex_train.values, ex_test.values\n",
    "        m.add_regressor(\"exog\")\n",
    "    m.fit(train)\n",
    "    return pd.Series(m.predict(test)[\"yhat\"].values, index=y_test.index)\n",
    "\n",
    "\n",
    "def run_language(lang):\n",
    "    \"\"\"Fits every model for one language and score it on the last TEST_DAYS days.\"\"\"\n",
    "    y = lang_mean[lang]\n",
    "    y_train, y_test = y[:-TEST_DAYS], y[-TEST_DAYS:]\n",
    "    use_exog = (lang == \"English\")            # campaign variable exists for English only\n",
    "    ex_train, ex_test = (exog[:-TEST_DAYS], exog[-TEST_DAYS:]) if use_exog else (None, None)\n",
    "\n",
    "    preds, params = {}, {}\n",
    "    # baseline\n",
    "    preds[\"SeasonalNaive\"] = pd.Series(np.resize(y_train[-SEASONAL_PERIOD:].values, TEST_DAYS), index=y_test.index)\n",
    "\n",
    "    params[\"ARIMA\"] = grid_search(y_train, seasonal=False)\n",
    "    preds[\"ARIMA\"] = sarimax_forecast(y_train, *params[\"ARIMA\"])\n",
    "\n",
    "    params[\"SARIMA\"] = grid_search(y_train)\n",
    "    preds[\"SARIMA\"] = sarimax_forecast(y_train, *params[\"SARIMA\"])\n",
    "\n",
    "    if use_exog:\n",
    "        preds[\"SARIMAX\"] = sarimax_forecast(y_train, *params[\"SARIMA\"], ex_train, ex_test)\n",
    "        preds[\"Prophet(exog)\"] = prophet_forecast(y_train, y_test, ex_train, ex_test)\n",
    "    preds[\"Prophet\"] = prophet_forecast(y_train, y_test)\n",
    "\n",
    "    rows = []\n",
    "    for name, pred in preds.items():\n",
    "        mae_, rmse_, mape_ = performance(y_test, pred, print_metrics=False)\n",
    "        rows.append({\"language\": lang, \"model\": name, \"MAE\": mae_, \"RMSE\": rmse_, \"MAPE\": mape_})\n",
    "    return pd.DataFrame(rows), preds, params\n",
    "\n",
    "\n",
    "# Run for every language\n",
    "all_results, all_preds, all_params = [], {}, {}\n",
    "for lang in LANGS:\n",
    "    print(\"Running\", lang)\n",
    "    res, all_preds[lang], all_params[lang] = run_language(lang)\n",
    "    all_results.append(res)\n",
    "\n",
    "results = pd.concat(all_results, ignore_index=True)\n",
    "\n",
    "# MAPE by language and model\n",
    "mape_table = results.pivot(index=\"language\", columns=\"model\", values=\"MAPE\")\n",
    "display(mape_table.style.highlight_min(axis=1, color=\"lightgreen\")\n",
    "        .set_caption(\"Test MAPE (%), lower is better\"))\n",
    "\n",
    "# Best model per language, compared with the naive baseline\n",
    "best = (results[results.model != \"SeasonalNaive\"]\n",
    "        .sort_values(\"MAPE\").groupby(\"language\").first()[[\"model\", \"MAPE\", \"RMSE\"]])\n",
    "best[\"naive_MAPE\"] = results[results.model == \"SeasonalNaive\"].set_index(\"language\")[\"MAPE\"]\n",
    "best[\"gain_vs_naive_%\"] = (1 - best[\"MAPE\"] / best[\"naive_MAPE\"]) * 100\n",
    "best[\"within_4_8%\"] = best[\"MAPE\"].between(4, 8) | (best[\"MAPE\"] < 4)\n",
    "display(best.round(2))\n",
    "\n",
    "# Orders- chosen by the grid search\n",
    "display(pd.DataFrame({l: {m: v for m, v in p.items()} for l, p in all_params.items()}).T)\n",
    "\n",
    "# Forecast plots using each language's best model\n",
    "fig, axes = plt.subplots(4, 2, figsize=(17, 16))\n",
    "for ax, lang in zip(axes.ravel(), LANGS):\n",
    "    y = lang_mean[lang]\n",
    "    ax.plot(y.iloc[-(TEST_DAYS + 60):], \"k\", label=\"actual\")\n",
    "    ax.plot(all_preds[lang][best.loc[lang, \"model\"]], \"r--\",\n",
    "            label=f\"{best.loc[lang, 'model']} forecast\")\n",
    "    ax.set_title(f\"{lang}  (MAPE {best.loc[lang, 'MAPE']:.1f}%)\")\n",
    "    ax.legend(fontsize=8)\n",
    "plt.tight_layout(); plt.show()"
