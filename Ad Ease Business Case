    "# Creating a function to print values of all error metrics.\n",
    "def performance(actual, predicted, print_metrics=True):\n",
    "    MAE = round(mae(actual, predicted), 3)\n",
    "    RMSE = round(mse(actual, predicted) ** 0.5, 3)\n",
    "    MAPE = round(mape(actual, predicted) * 100, 3)\n",
    "    if print_metrics:\n",
    "        print(\"MAE :\", MAE)\n",
    "        print(\"RMSE :\", RMSE)\n",
    "        print(\"MAPE:\", MAPE)\n",
    "    return MAE, RMSE, MAPE"
   ]
