    "Format of page: NAME _ LANGUAGE.wikipedia.org _ ACCESS TYPE _ ACCESS ORIGIN.\n",
    "This gives the information about the page name, domain, device type, request origin"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 70,
   "metadata": {
    "colab": {
     "base_uri": "https://localhost:8080/",
     "height": 0
    },
    "id": "VRyF715lyg7P",
    "outputId": "4e29f721-7fdb-427c-de83-61da6014ee90"
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Pages not matched by regex: 0\n"
     ]
    }
   ],
   "source": [
    "# Parse the Page column in one vectorized pass\n",
    "pattern = (\n",
    "    r\"^(?P<name>.+)_(?P<project>[a-z\\-]+)\\.(?P<domain>wikipedia|wikimedia|mediawiki)\\.org_\"\n",
    "    r\"(?P<access_type>all-access|desktop|mobile-web)_(?P<access_origin>all-agents|spider)$\"\n",
    ")\n",
    "meta = df[\"Page\"].str.extract(pattern)\n",
    "unmatched = meta[\"domain\"].isna()\n",
    "print(\"Pages not matched by regex:\", unmatched.sum())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 71,
   "metadata": {
    "id": "X5c86uRJXZ85"
   },
   "outputs": [],
   "source": [
    "# Language: use the project code only for *.wikipedia.org- commons/www are \"media\", failed parses are marked as \"unknown\"\n",
    "meta[\"lang_code\"] = (\n",
    "    meta[\"project\"]\n",
    "    .where(meta[\"domain\"].eq(\"wikipedia\"), \"media\")\n",
    "    .mask(unmatched, \"unknown\")\n",
    ")\n",
    "\n",
    "lang_names = {\n",
    "    \"en\": \"English\", \"de\": \"German\", \"fr\": \"French\", \"es\": \"Spanish\",\n",
    "    \"ru\": \"Russian\", \"ja\": \"Japanese\", \"zh\": \"Chinese\",\n",
    "    \"media\": \"Media (Commons/MediaWiki)\", \"unknown\": \"Unknown\",\n",
    "}\n",
    "# fall back to the raw code so nothing becomes NaN\n",
    "meta[\"language\"] = meta[\"lang_code\"].map(lang_names).fillna(meta[\"lang_code\"])"
   ]
  },
