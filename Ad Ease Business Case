    "def pie_with_legend(series, title):\n",
    "    counts = series.value_counts()\n",
    "    pct = counts / counts.sum() * 100\n",
    "    fig, ax = plt.subplots(figsize=(6, 6))\n",
    "    wedges, _, autotexts = ax.pie(\n",
    "        counts,\n",
    "        labels=None,\n",
    "        autopct=lambda p: f\"{p:.1f}%\" if p >= 2 else \"\",\n",
    "        startangle=90,\n",
    "        pctdistance=0.8,\n",
    "        wedgeprops={\"edgecolor\": \"white\"},\n",
    "    )\n",
    "    # legend carries the names and exact percentages\n",
    "    ax.legend(wedges, [f\"{k} ({v:.1f}%)\" for k, v in pct.items()],\n",
    "              title=series.name, loc=\"center left\", bbox_to_anchor=(1, 0.5))\n",
    "    ax.set_title(title)\n",
    "    ax.set_ylabel(\"\")\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
